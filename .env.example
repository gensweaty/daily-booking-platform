# Frontend (publishable) values only — safe to commit.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_PAYPAL_CLIENT_ID="your-paypal-client-id"

# Server-side secrets are NOT stored here.
# Set these as Supabase Edge Function secrets instead:
#   STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRODUCT_ID,
#   PAYPAL_CLIENT_ID, PAYPAL_SECRET_KEY, RESEND_API_KEY, ...
